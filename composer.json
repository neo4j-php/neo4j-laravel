{
  "name": "neo4j-php/neo4j-laravel",
  "description": "A Laravel package for Neo4j integration",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Neo4j\\Neo4jLaravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Neo4j\\Neo4jLaravel\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "illuminate/database": "^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    "laudis/neo4j-php-client": "^3.2",
    "wikibase-solutions/php-cypher-dsl": "^5.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^10.5 || ^11.5",
    "psalm/plugin-laravel": "^2.12",
    "friendsofphp/php-cs-fixer": "^3.69",
    "barryvdh/laravel-debugbar": "^3.15",
    "vimeo/psalm": "^5.0"
  },
  "scripts": {
    "psalm": "vendor/bin/psalm",
    "cs": "vendor/bin/php-cs-fixer fix",
    "analyze": [
      "@cs",
      "@psalm"
    ],
    "test": "vendor/bin/phpunit",
    "test:unit": "vendor/bin/phpunit --testsuite Unit",
    "test:integration": "vendor/bin/phpunit --testsuite Integration",
    "ci-laravel-install-version": "./.github/scripts/setup-laravel-env.bash"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Neo4j\\Neo4jLaravel\\Neo4jServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "suggest": {
    "barryvdh/laravel-debugbar": "Shows Neo4j Cypher in Debugbar's Queries tab via QueryExecuted (or fruitcake/laravel-debugbar)",
    "fruitcake/laravel-debugbar": "Alternative Laravel Debugbar package (v4+) that shows Neo4j Cypher in the Queries tab"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
